function goalCalc(r){
  var left=Math.max(r.target-r.saved,0),p=r.target?r.saved/r.target:0,need=0,st;
  var cm=todayStr().slice(0,7);
  if(left<=0){st={k:'good',t:'✓ Tercapai'};}
  else if(r.deadline){
    var ml=(+r.deadline.slice(0,4)-+cm.slice(0,4))*12+(+r.deadline.slice(5,7)-+cm.slice(5,7))+1;
    if(ml<=0){st={k:'bad',t:'▲ Tenggat lewat'};need=left;}
    else{need=Math.ceil(left/ml/1000)*1000;st={k:'mute',t:ml+' bulan lagi'};}
  }else{st={k:'mute',t:'Tanpa tenggat'};}
  return {left:left,p:p,need:need,st:st};
}
