function ensureMonth(k){
  if(state.months[k])return state.months[k];
  var keys=Object.keys(state.months).sort(),src=null,i;
  for(i=0;i<keys.length;i++){if(keys[i]<k)src=state.months[keys[i]];}
  if(!src&&keys.length)src=state.months[keys[0]];
  var budgets={};
  CATS.forEach(function(c){budgets[c.id]=(src&&src.budgets[c.id]!=null)?src.budgets[c.id]:c.def;});
  state.months[k]={plan:src?src.plan:0,budgets:budgets};
  return state.months[k];
}
function calc(k){
  var m=ensureMonth(k),days=daysIn(k),per={},daily=[],i,inc=0,out=0;
  CATS.forEach(function(c){per[c.id]=0;});
  for(i=0;i<=days;i++)daily.push(0);
  state.tx.forEach(function(t){
    if(t.date.slice(0,7)!==k)return;
    var d=+t.date.slice(8,10);
    if(t.type==='in'){inc+=t.amount;}
    else{out+=t.amount;if(per[t.cat]!=null)per[t.cat]+=t.amount;daily[d]+=t.amount;}
  });
  var budget=CATS.reduce(function(s,c){return s+(m.budgets[c.id]||0);},0);
  return {m:m,days:days,per:per,daily:daily,inc:inc,out:out,budget:budget,bal:inc-out};
}

