async function runExport(kind){
  if(busy||dlState!=='ok')return;
  busy=true;updateExportUI();
  var btn=kind==='xlsx'?$('#expXlsx'):$('#expPdf'),st=kind==='xlsx'?$('#xs-xlsx'):$('#xs-pdf'),label=btn.textContent;
  btn.textContent='Menyiapkan…';st.textContent='';
  try{
    var data,name;
    if(kind==='xlsx'){await loadXlsx();data=await buildXlsx();name='pundi-harian-'+ym+'.xlsx';}
    else{await loadPdf();data=await buildPdf();name='laporan-keuangan-'+ym+'.pdf';}
    await dl.save({filename:name,data:data});
    st.textContent='Tersimpan sebagai '+name+'.';
  }catch(err){
    if(err&&err.code==='declined'){st.textContent='Dibatalkan. Tekan tombol lagi jika ingin mengunduh.';}
    else if(err&&err.code==='rate_limited'){st.textContent='Tunggu sebentar lalu coba lagi.';}
    else{st.textContent='Belum berhasil: '+((err&&err.message)||'terjadi kesalahan')+'.';}
  }finally{busy=false;btn.textContent=label;updateExportUI();}
}
