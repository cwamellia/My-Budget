    row.getCell(6).value=r.deadline?dateUTC(r.deadline):'-';
    [2,3,4].forEach(function(x){row.getCell(x).numFmt=RP;});row.getCell(5).numFmt='0%';
    if(r.deadline)row.getCell(6).numFmt='dd/mm/yyyy';
  });

  var buf=await wb.xlsx.writeBuffer();
  return new Blob([buf],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
}

