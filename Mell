/* ---------- render: trend ---------- */
function renderTrend(c){
  var days=c.days,el=elapsed(ym,days),cum=[0],s=0,d;
  for(d=1;d<=days;d++){s+=c.daily[d];cum.push(s);}
  var last=el?cum[el]:0;
  var maxV=Math.max(c.budget,last,1);
  var step=niceStep(maxV/4),yMax=Math.ceil(maxV/step)*step;
  var VW=640,VH=280,L=58,R=22,T=16,B=30,pw=VW-L-R,ph=VH-T-B;
  function X(dd){return L+(dd-1)/(days-1)*pw;}
  function Y(v){return T+ph-(v/yMax)*ph;}
  var g='',v;
  for(v=0;v<=yMax+1e-6;v+=step){
    g+='<line x1="'+L+'" x2="'+(VW-R)+'" y1="'+Y(v).toFixed(1)+'" y2="'+Y(v).toFixed(1)+'" stroke="var(--line)" stroke-width="1"/>';
    g+='<text x="'+(L-8)+'" y="'+(Y(v)+4).toFixed(1)+'" text-anchor="end">'+esc(v===0?'0':short(v).replace('Rp ',''))+'</text>';
  }
  var ticks=[1,8,15,22,days];
  ticks.forEach(function(t){g+='<text x="'+X(t).toFixed(1)+'" y="'+(VH-8)+'" text-anchor="middle">'+t+'</text>';});
  var pace=c.budget?'<line x1="'+X(1).toFixed(1)+'" y1="'+Y(c.budget/days).toFixed(1)+'" x2="'+X(days).toFixed(1)+'" y2="'+Y(c.budget).toFixed(1)+'" stroke="var(--ink-2)" stroke-width="2" stroke-dasharray="6 5"/>'+
    '<text class="lab2" x="'+(X(days)).toFixed(1)+'" y="'+(Y(c.budget)-8).toFixed(1)+'" text-anchor="end">Anggaran '+esc(short(c.budget))+'</text>':'';
  var line='',area='',dotEl='',endLab='';
  if(el>0){
    var pts=[];for(d=1;d<=el;d++)pts.push(X(d).toFixed(1)+' '+Y(cum[d]).toFixed(1));
    line='<path d="M'+pts.join(' L')+'" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>';
    area='<path d="M'+pts.join(' L')+' L'+X(el).toFixed(1)+' '+Y(0).toFixed(1)+' L'+X(1).toFixed(1)+' '+Y(0).toFixed(1)+' Z" fill="var(--accent)" fill-opacity="0.12"/>';
    dotEl='<circle cx="'+X(el).toFixed(1)+'" cy="'+Y(last).toFixed(1)+'" r="5" fill="var(--accent)" stroke="var(--surface)" stroke-width="2"/>';
    var paceAt=c.budget*el/days,above=last>=paceAt;
    endLab='<text class="lab" x="'+(X(el)-2).toFixed(1)+'" y="'+(Y(last)+(above?-12:20)).toFixed(1)+'" text-anchor="end">'+esc(short(last))+'</text>';
  }else{
    endLab='<text x="'+(VW/2)+'" y="'+(VH/2)+'" text-anchor="middle">Belum ada data pengeluaran</text>';
  }
  var cross='<line id="xh" y1="'+T+'" y2="'+(T+ph)+'" stroke="var(--muted)" stroke-width="1" stroke-dasharray="3 3" visibility="hidden"/><circle id="xd" r="5" fill="var(--accent)" stroke="var(--surface)" stroke-width="2" visibility="hidden"/>';
  var hov=el>0?'<rect class="hov" id="hov" x="'+L+'" y="'+T+'" width="'+pw+'" height="'+ph+'" fill="transparent"/>':'';
  $('#trend').innerHTML='<svg class="trend" id="trendSvg" viewBox="0 0 '+VW+' '+VH+'" role="img" aria-label="Grafik garis pengeluaran terkumpul per tanggal, '+esc(monthLabel(ym))+', total '+esc(rp(last))+'">'+
    g+area+pace+line+dotEl+endLab+cross+hov+'</svg>';
  var h=$('#hov');
  if(h){
    var svg=$('#trendSvg');
    h.addEventListener('pointermove',function(e){
      var r=svg.getBoundingClientRect(),px=(e.clientX-r.left)*(VW/r.width);
      var dd=Math.round((px-L)/pw*(days-1))+1;dd=Math.max(1,Math.min(el,dd));
      var xh=$('#xh'),xd=$('#xd');
      xh.setAttribute('x1',X(dd));xh.setAttribute('x2',X(dd));xh.setAttribute('visibility','visible');
      xd.setAttribute('cx',X(dd));xd.setAttribute('cy',Y(cum[dd]));xd.setAttribute('visibility','visible');
      showTip(e.clientX,e.clientY,dd+' '+BLN[+ym.slice(5)-1],'Terkumpul '+rp(cum[dd])+'\nHari itu '+rp(c.daily[dd]));
    });
    h.addEventListener('pointerleave',function(){hideTip();$('#xh').setAttribute('visibility','hidden');$('#xd').setAttribute('visibility','hidden');});
  }
}

