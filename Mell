function emergencyBase(){
  var per={},cm=todayStr().slice(0,7);
  state.tx.forEach(function(t){
    if(t.type!=='out'||t.cat==='tabungan')return;
    var k=t.date.slice(0,7);per[k]=(per[k]||0)+t.amount;
  });
  var keys=Object.keys(per);
  if(keys.length){
    var tot=0;
    keys.forEach(function(k){var v=per[k];if(k===cm){var d=daysIn(k),el=elapsed(k,d);if(el>0)v=v*d/el;}tot+=v;});
    return {v:Math.round(tot/keys.length/10000)*10000,src:'Rata-rata pengeluaran '+keys.length+' bulan, di luar tabungan'};
  }
  var c=calc(ym);
  return {v:Math.max(c.budget-(c.m.budgets.tabungan||0),0),src:'Dari total anggaran bulan ini, di luar tabungan'};
}
