  S.savings.sample=!!sv.sample;
  (Array.isArray(sv.goals)?sv.goals:[]).forEach(function(g){
    if(g&&isStr(g.id)&&isStr(g.name)&&g.name.trim()&&num(g.target)>0)S.savings.goals.push({id:g.id.slice(0,40),name:g.name.trim().slice(0,40),target:num(g.target),start:num(g.start),deadline:validDate(g.deadline)?g.deadline:''});
  });
  (Array.isArray(d.recurring)?d.recurring:[]).forEach(function(r){
    if(!r||(r.type!=='in'&&r.type!=='out')||!(num(r.amount)>0)||!(r.day>=1&&r.day<=31)||!/^\d{4}-\d{2}$/.test(r.start)||!/^\d{4}-\d{2}$/.test(r.last)){skipped++;return;}
    S.recurring.push({id:isStr(r.id)&&r.id?r.id.slice(0,40):uid(),type:r.type,cat:isStr(r.cat)?r.cat.slice(0,40):'',acct:accIds[r.acct]?r.acct:first,amount:num(r.amount),note:isStr(r.note)?r.note.slice(0,80):'',day:Math.floor(r.day),start:r.start,last:r.last});
  });
  if(d.meta&&isStr(d.meta.lastBackup))S.meta.lastBackup=d.meta.lastBackup.slice(0,40);
  return {state:S,skipped:skipped};
}
