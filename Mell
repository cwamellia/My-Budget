async function buildXlsx(){
  var c=calc(ym),txs=monthTx(ym),all=state.tx.slice().sort(function(a,b){return a.date<b.date?-1:a.date>b.date?1:0;});
  var wb=new ExcelJS.Workbook();wb.creator='Pundi Harian';wb.created=new Date();
  var RP='"Rp "#,##0',PLUM='FF2F2747';
  function head(row){row.eachCell(function(cell){cell.font={bold:true,color:{argb:'FFFFFFFF'}};cell.fill={type:'pattern',pattern:'solid',fgColor:{argb:PLUM}};cell.alignment={vertical:'middle',horizontal:'left'};});row.height=22;}
  var wsS=wb.addWorksheet('Ringkasan',{views:[{showGridLines:false}]});
  var wsB=wb.addWorksheet('Anggaran',{views:[{showGridLines:false,state:'frozen',ySplit:4}]});
