/* ---------- backup and restore ---------- */
function requestPersist(){try{if(navigator.storage&&navigator.storage.persist)navigator.storage.persist();}catch(e){}}
function isStr(x){return typeof x==='string';}
function num(x){x=+x;return (isFinite(x)&&x>0)?Math.min(Math.round(x),9e12):0;}
function sanitize(raw){
  var d=raw&&raw.data?raw.data:raw;
  if(!d||typeof d!=='object'||!Array.isArray(d.tx))throw new Error('Format file tidak dikenali. Gunakan file cadangan dari Pundi Harian.');
  var S={months:{},tx:[],savings:defSavings(),accounts:[],transfers:[],customCats:[],recurring:[],meta:{}},skipped=0,catIds={},accIds={};
  CATS.slice(0,BASE_CATS).forEach(function(c){catIds[c.id]=1;});
  (Array.isArray(d.customCats)?d.customCats:[]).slice(0,8).forEach(function(c,n){
    if(!(c&&isStr(c.id)&&isStr(c.name)&&c.name.trim()))return;
    var id=c.id.slice(0,40);if(catIds[id])return;
    catIds[id]=1;S.customCats.push({id:id,name:c.name.trim().slice(0,24),i:(c.i>=1&&c.i<=8)?Math.floor(c.i):((BASE_CATS+n)%8)+1});
  });
  (Array.isArray(d.accounts)?d.accounts:[]).forEach(function(a){
    if(!(a&&isStr(a.id)&&isStr(a.name)&&a.name.trim()))return;
    var id=a.id.slice(0,40);if(accIds[id])return;
    accIds[id]=1;S.accounts.push({id:id,name:a.name.trim().slice(0,30),start:num(a.start),sample:!!a.sample});
  });
  if(!S.accounts.length){S.accounts=defAccounts();accIds={};accIds[S.accounts[0].id]=1;}
  var first=S.accounts[0].id,txIds={};
  d.tx.forEach(function(t){
    if(!t||!validDate(t.date)||(t.type!=='in'&&t.type!=='out')||!(num(t.amount)>0)){skipped++;return;}
    var id=(isStr(t.id)&&t.id&&!txIds[t.id])?t.id.slice(0,40):uid();txIds[id]=1;
    var cat=isStr(t.cat)?t.cat.slice(0,40):'';
    if(t.type==='out'&&!catIds[cat])cat='belanja';
    if(t.type==='in'&&!cat)cat='Lainnya';
    var o={id:id,date:t.date,type:t.type,cat:cat,acct:accIds[t.acct]?t.acct:first,note:isStr(t.note)?t.note.slice(0,80):'',amount:num(t.amount)};
    if(isStr(t.goal)&&t.goal)o.goal=t.goal.slice(0,40);
    if(isStr(t.rec)&&t.rec)o.rec=t.rec.slice(0,40);
    if(t.sample)o.sample=true;
    S.tx.push(o);
  });
  (Array.isArray(d.transfers)?d.transfers:[]).forEach(function(x){
    if(!x||!validDate(x.date)||!accIds[x.from]||!accIds[x.to]||x.from===x.to||!(num(x.amount)>0)){skipped++;return;}
    var o={id:isStr(x.id)&&x.id?x.id.slice(0,40):uid(),date:x.date,from:x.from,to:x.to,amount:num(x.amount),note:isStr(x.note)?x.note.slice(0,80):''};
    if(x.sample)o.sample=true;S.transfers.push(o);
  });
  if(d.months&&typeof d.months==='object')Object.keys(d.months).forEach(function(k){
    if(!/^\d{4}-(0[1-9]|1[0-2])$/.test(k))return;
    var m=d.months[k]||{},b={};
    Object.keys(catIds).forEach(function(id){b[id]=num(m.budgets&&m.budgets[id]);});
    S.months[k]={plan:num(m.plan),budgets:b};
  });
  var sv=(d.savings&&typeof d.savings==='object')?d.savings:{},em=sv.emergency||{};
