function runRecurring(){
  var today=todayStr(),cm=today.slice(0,7),added=0;
  state.recurring.forEach(function(r){
    var guard=0,mk=shiftMonth(r.last,1);
    while(mk<=cm&&guard<120){
      guard++;
      var ds=mk+'-'+pad(Math.min(r.day,daysIn(mk)));
      if(ds>today)break;
      state.tx.push({id:uid(),date:ds,type:r.type,cat:r.cat,acct:acctById(r.acct)?r.acct:state.accounts[0].id,note:r.note,amount:r.amount,rec:r.id});
      r.last=mk;added++;mk=shiftMonth(mk,1);
    }
  });
  if(added)save();
  return added;
}
