  if(keys.length){return {v:Math.round(keys.reduce(function(a,k){return a+per[k];},0)/keys.length),src:'rata-rata pemasukan'};}
  return {v:0,src:''};
}
function habit(){
  var cm=todayStr().slice(0,7),per={};
  state.tx.forEach(function(t){
    if(t.type!=='out'||t.cat==='tabungan')return;
    var k=t.date.slice(0,7);per[k]=per[k]||{};per[k][t.cat]=(per[k][t.cat]||0)+t.amount;
  });
  var keys=Object.keys(per).sort().slice(-3);
  if(!keys.length)return null;
  var out={};CATS.forEach(function(c){out[c.id]=0;});
  keys.forEach(function(k){
    var f=1;if(k===cm){var d=daysIn(k),el=elapsed(k,d);if(el>0)f=d/el;}
    CATS.forEach(function(c){out[c.id]+=(per[k][c.id]||0)*f;});
  });
  CATS.forEach(function(c){out[c.id]/=keys.length;});
  return out;
}
function computeRec(key){
  var inc=incomeBase();if(!inc.v)return null;
  var S=STRAT[key],I=inc.v,rec={},note='',useHabit=false;
  function r10(n){return Math.round(n/10000)*10000;}
  if(key==='kebiasaan'){
    var h=habit(),tot=0;
    if(h){CATS.forEach(function(k){if(k.id!=='tabungan')tot+=h[k.id];});}
    if(h&&tot>0){
      useHabit=true;
      var sum=0,pool=I*(1-S.s),sc=1;
      CATS.forEach(function(k){
        if(k.id==='tabungan')return;
        rec[k.id]=h[k.id]*((k.id==='tinggal'||k.id==='tagihan')?1:1.1);
        sum+=rec[k.id];
      });
      if(sum>pool){sc=pool/sum;CATS.forEach(function(k){if(k.id!=='tabungan')rec[k.id]*=sc;});sum=pool;note='Pengeluaranmu lebih besar dari pemasukan setelah tabungan, jadi tiap kategori dipangkas proporsional.';}
      rec.tabungan=Math.min(I-sum,I*0.35);
      if(rec.tabungan>I*S.s+1)note='Tiap kategori mengikuti kebiasaanmu dengan ruang 10%. Sisa pemasukan masuk ke tabungan (maksimal 35%).';
    }else{note='Belum ada riwayat pengeluaran, jadi saran memakai pola 50/30/20.';}
  }
  if(!useHabit){
    var n=S.n!=null?S.n:0.5,w=S.w!=null?S.w:0.3;
    Object.keys(NEEDS).forEach(function(id){rec[id]=I*n*NEEDS[id];});
    Object.keys(WANTS).forEach(function(id){rec[id]=I*w*WANTS[id];});
  }
  if(!useHabit)rec.tabungan=I*S.s;
  CATS.forEach(function(k){if(rec[k.id]==null)rec[k.id]=ensureMonth(ym).budgets[k.id]||0;rec[k.id]=r10(rec[k.id]);});
  return {rec:rec,inc:inc,S:S,note:note};
}
