  wsS.getCell('A11').value='Dibuat '+fmtFull(todayStr())+' dengan Pundi Harian';wsS.getCell('A11').font={italic:true,color:{argb:'FF7A7392'}};

  wsV.columns=[{width:30},{width:18},{width:18},{width:18},{width:12},{width:16}];
  var vh=wsV.getRow(1);['Nama','Target','Terkumpul','Sisa','Progres','Tenggat'].forEach(function(h,i){vh.getCell(i+1).value=h;});head(vh);
