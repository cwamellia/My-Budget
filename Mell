  function fillTx(ws,list,withMonth){
    ws.columns=[{header:'Tanggal',key:'d',width:14},{header:'Tipe',key:'t',width:13},{header:'Kategori',key:'c',width:20},{header:'Catatan',key:'n',width:36},{header:'Jumlah',key:'a',width:18}];
    head(ws.getRow(1));
    list.forEach(function(t){
      var r=ws.addRow({d:dateUTC(t.date),t:t.type==='in'?'Masuk':'Keluar',c:catName(t),n:t.note||'',a:t.amount});
      r.getCell('d').numFmt='dd/mm/yyyy';r.getCell('a').numFmt=RP;
    });
  }
  fillTx(wsT,txs);fillTx(wsA,all);

  /* Anggaran */
  wsB.columns=[{width:24},{width:18},{width:18},{width:18},{width:12},{width:16}];
  wsB.mergeCells('A1:F1');wsB.getCell('A1').value='Anggaran '+monthLabel(ym);wsB.getCell('A1').font={bold:true,size:16,color:{argb:PLUM}};
