<!doctype html><html><head><meta charset=utf8><link rel="manifest" href="manifest.webmanifest"><meta name="theme-color" content="#2f2747"><link rel="apple-touch-icon" href="icon-192.png"><meta name="mobile-web-app-capable" content="yes"><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Pundi Harian</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* Layout: one column app. Plum balance card on top, then four tabs (Ringkasan, Anggaran, Transaksi, Ekspor).
   Palette: lilac mist ground, plum ink, rose accent. Chart colors c1-c8 are the validated categorical set. */
:root{
  --bg:#f2eff8; --surface:#fbfaff; --surface-2:#ebe6f4; --ink:#2b2540; --ink-2:#5b5575; --muted:#7a7392; --line:#ded8ec;
  --accent:#b24a73; --accent-ink:#ffffff; --accent-soft:#f4dce7;
  --hero-bg:#2f2747; --hero-ink:#f6f2ff; --hero-ink-2:#c9c0e0; --hero-fill:#f3b3cd; --hero-over:#ffa99e;
  --good:#2b7a57; --warn:#9a5f00; --bad:#bf3a30;
  --good-soft:#dcefe5; --warn-soft:#f7e8c9; --bad-soft:#f8dad6;
  --c1:#2a78d6; --c2:#eb6834; --c3:#1baf7a; --c4:#eda100; --c5:#e87ba4; --c6:#008300; --c7:#6250d6; --c8:#e34948;
  --shadow:0 1px 2px rgba(43,37,64,.06),0 10px 28px rgba(43,37,64,.07);
  --serif:'Instrument Serif',Georgia,'Times New Roman',serif;
  --sans:'Plus Jakarta Sans',system-ui,-apple-system,'Segoe UI',sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#16121e; --surface:#201a2d; --surface-2:#2a2339; --ink:#f0ecfa; --ink-2:#c2bbd8; --muted:#9a93b2; --line:#382f4d;
    --accent:#e88db1; --accent-ink:#2b1020; --accent-soft:#3d2536;
    --hero-bg:#2c2442; --hero-ink:#f6f2ff; --hero-ink-2:#c9c0e0; --hero-fill:#e88db1; --hero-over:#ff9c8f;
    --good:#6fcf9f; --warn:#e8b04a; --bad:#f08a7e;
    --good-soft:#1d3329; --warn-soft:#3a2f17; --bad-soft:#3d2220;
    --c1:#3987e5; --c2:#d95926; --c3:#199e70; --c4:#c98500; --c5:#d55181; --c6:#008300; --c7:#9085e9; --c8:#e66767;
    --shadow:0 1px 2px rgba(0,0,0,.3),0 10px 28px rgba(0,0,0,.25);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#16121e; --surface:#201a2d; --surface-2:#2a2339; --ink:#f0ecfa; --ink-2:#c2bbd8; --muted:#9a93b2; --line:#382f4d;
  --accent:#e88db1; --accent-ink:#2b1020; --accent-soft:#3d2536;
  --hero-bg:#2c2442; --hero-ink:#f6f2ff; --hero-ink-2:#c9c0e0; --hero-fill:#e88db1; --hero-over:#ff9c8f;
  --good:#6fcf9f; --warn:#e8b04a; --bad:#f08a7e;
  --good-soft:#1d3329; --warn-soft:#3a2f17; --bad-soft:#3d2220;
  --c1:#3987e5; --c2:#d95926; --c3:#199e70; --c4:#c98500; --c5:#d55181; --c6:#008300; --c7:#9085e9; --c8:#e66767;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 10px 28px rgba(0,0,0,.25);
  color-scheme:dark;
}

*{box-sizing:border-box}
body{
  background:var(--bg); color:var(--ink); font-family:var(--sans); font-size:14px; line-height:1.5;
  padding-left:max(16px,env(safe-area-inset-left,0px)); padding-right:max(16px,env(safe-area-inset-right,0px));
  padding-block:20px 56px; -webkit-text-size-adjust:100%;
}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
h1,h2,h3,p{margin:0}
.app{max-width:1040px;margin:0 auto;display:grid;gap:20px;min-width:0}
.app>*{min-width:0}

/* header */
.top{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 20px}
.brand h1{font-family:var(--serif);font-weight:400;font-size:36px;line-height:1.05;letter-spacing:-.01em}
.brand p{color:var(--muted);font-size:13px;margin-top:2px}
.month{display:flex;align-items:center;gap:2px;background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:4px;box-shadow:var(--shadow)}
.month button{width:40px;height:40px;border:0;border-radius:50%;background:transparent;display:grid;place-items:center;color:var(--ink-2)}
.month button:hover{background:var(--surface-2)}
.month span{min-width:136px;text-align:center;font-weight:600}

/* hero */
.hero{background:var(--hero-bg);color:var(--hero-ink);border-radius:28px;padding:clamp(20px,4vw,34px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:26px 40px;position:relative;overflow:hidden;box-shadow:var(--shadow)}
.hero::after{content:"";position:absolute;right:-90px;top:-110px;width:340px;height:340px;border-radius:50%;background:radial-gradient(circle at 50% 50%,rgba(232,141,177,.38),transparent 65%);pointer-events:none}
.hero>*{position:relative;z-index:1;min-width:0}
.eyebrow{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--hero-ink-2);font-weight:600}
.bal{font-family:var(--serif);font-size:clamp(44px,9vw,74px);line-height:1;letter-spacing:-.02em;margin-top:8px;overflow-wrap:anywhere}
.bal.neg{color:var(--hero-over)}
.hero-split{display:flex;flex-wrap:wrap;gap:12px 30px;margin-top:20px}
.hero-split .lbl{display:block;font-size:12px;color:var(--hero-ink-2)}
.hero-split strong{font-size:16px;font-weight:600;font-variant-numeric:tabular-nums}
.hero-prog{align-self:end}
.hp-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;font-size:13px;color:var(--hero-ink-2)}
.hp-head b{font-family:var(--serif);font-weight:400;font-size:30px;color:var(--hero-ink)}
.track{height:10px;background:var(--surface-2);border-radius:999px;overflow:hidden}
.track .fill{height:100%;border-radius:999px;background:var(--accent);transition:width .45s ease}
.track.on-dark{background:rgba(255,255,255,.16);margin:8px 0}
.track.on-dark .fill{background:var(--hero-fill)}
.track.on-dark.over .fill{background:var(--hero-over)}
.hero-prog p{font-size:13px;color:var(--hero-ink-2)}

.banner{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 16px;background:var(--accent-soft);border-radius:16px;padding:12px 16px;font-size:13px}
.banner button{border:1px solid var(--accent);background:transparent;color:var(--accent);border-radius:999px;padding:6px 14px;font-weight:600}
.banner button:hover{background:var(--surface)}

/* tabs */
.tabs{display:flex;gap:4px;padding:4px;background:var(--surface-2);border-radius:999px;overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tabs button{flex:1 0 auto;border:0;background:transparent;padding:10px 18px;border-radius:999px;font-weight:600;color:var(--ink-2);white-space:nowrap}
.tabs button[aria-selected="true"]{background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}

/* cards and headings */
.panel{display:grid;gap:20px}
.panel[hidden]{display:none}
.card{background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:clamp(16px,3vw,24px);min-width:0}
.card h2{font-family:var(--serif);font-weight:400;font-size:26px;line-height:1.15}
.card .sub{color:var(--muted);font-size:13px;margin-top:2px}
.ch{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:6px 16px;margin-bottom:16px}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:20px}
.grid2>*{min-width:0}

/* insights */
.insights{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr));gap:0}
.ins{padding:4px 20px;border-left:1px solid var(--line)}
.ins:first-child{border-left:0;padding-left:0}
.ins .k{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
.ins .v{font-family:var(--serif);font-size:28px;line-height:1.2;margin-top:2px;overflow-wrap:anywhere}
.ins .s{font-size:12.5px;color:var(--ink-2)}
@media (max-width:700px){.ins{border-left:0;padding:12px 0;border-top:1px solid var(--line)}.ins:first-child{border-top:0;padding-top:0}}

.dot{display:inline-block;width:10px;height:10px;border-radius:3px;flex:none}
.empty{display:grid;gap:10px;justify-items:start;color:var(--ink-2)}
.empty h3{font-family:var(--serif);font-weight:400;font-size:22px;color:var(--ink)}
.btn{border:0;background:var(--accent);color:var(--accent-ink);border-radius:14px;padding:12px 20px;font-weight:700;min-height:44px}
.btn:hover{filter:brightness(1.06)}
.btn:disabled{opacity:.5;cursor:not-allowed;filter:none}
.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
.btn.ghost:hover{background:var(--surface-2)}
.btn.danger{background:transparent;color:var(--bad);border:1px solid var(--bad)}

/* donut */
.donut-wrap{display:flex;flex-wrap:wrap;gap:20px 24px;align-items:center;justify-content:center}
.donut{width:200px;height:200px;flex:none}
.donut .seg{transition:opacity .15s}
.donut .seg:hover{opacity:.8}
.dc-l{font-size:11px;letter-spacing:.08em;text-transform:uppercase;fill:var(--muted);font-weight:600;font-family:var(--sans)}
.dc-v{font-size:24px;fill:var(--ink);font-family:var(--serif)}
.legend{list-style:none;margin:0;padding:0;flex:1 1 220px;display:grid;gap:8px;min-width:0}
.legend li{display:grid;grid-template-columns:auto 1fr auto 40px;gap:10px;align-items:center;font-size:13px}
.legend .nm{min-width:0;overflow-wrap:anywhere}
.legend .amt{font-variant-numeric:tabular-nums;font-weight:600}
.legend .pc{text-align:right;color:var(--muted);font-variant-numeric:tabular-nums}
.legend li.zero{color:var(--muted)}

/* bars (anggaran vs terpakai) */
.blist{display:grid;gap:14px}
.bitem{display:grid;grid-template-columns:1fr auto;gap:6px 12px;align-items:baseline}
.bitem .nm{display:flex;gap:8px;align-items:center;font-weight:600;min-width:0}
.bitem .num{font-size:12.5px;color:var(--ink-2);font-variant-numeric:tabular-nums;text-align:right}
.bitem .num.over{color:var(--bad);font-weight:700}
.bitem .track{grid-column:1/-1;height:10px}
.bitem .track .fill{background:var(--cc)}
.keynote{font-size:12px;color:var(--muted);margin-top:14px}

/* trend */
.legend-row{display:flex;flex-wrap:wrap;gap:6px 18px;font-size:12.5px;color:var(--ink-2)}
.legend-row span{display:inline-flex;align-items:center;gap:7px}
.sw-line{width:18px;height:0;border-top:3px solid var(--accent);border-radius:2px}
.sw-dash{width:18px;height:0;border-top:2px dashed var(--ink-2)}
.trend{width:100%;height:auto;display:block;touch-action:pan-y}
.trend text{font-family:var(--sans);font-size:11px;fill:var(--muted)}
.trend .lab{fill:var(--ink);font-weight:600}
.trend .lab2{fill:var(--ink-2)}

/* pills */
.pill{display:inline-flex;align-items:center;gap:4px;padding:2px 10px;border-radius:999px;font-size:12px;font-weight:700;white-space:nowrap}
.pill.good{background:var(--good-soft);color:var(--good)}
.pill.warn{background:var(--warn-soft);color:var(--warn)}
.pill.bad{background:var(--bad-soft);color:var(--bad)}
.pill.mute{background:var(--surface-2);color:var(--muted)}

/* forms */
.field{display:grid;gap:6px;min-width:0}
.field>label,.field>.lab{font-size:12.5px;font-weight:600;color:var(--ink-2)}
input[type=text],input[type=date],select{width:100%;min-height:46px;padding:10px 14px;background:var(--surface);border:1px solid var(--line);border-radius:14px;color:var(--ink)}
input::placeholder{color:var(--muted)}
.money{position:relative}
.money span{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--muted);font-weight:600;pointer-events:none}
.money input{padding-left:42px;font-variant-numeric:tabular-nums}
.segmented{display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:4px;background:var(--surface-2);border-radius:16px}
.segmented label{position:relative;display:block}
.segmented input{position:absolute;inset:0;opacity:0;cursor:pointer;margin:0}
.segmented span{display:block;text-align:center;padding:10px;border-radius:12px;font-weight:600;color:var(--ink-2)}
.segmented input:checked+span{background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}
.segmented input:focus-visible+span{outline:2px solid var(--accent)}
.form{display:grid;gap:14px}
.row2{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,160px),1fr));gap:14px}
.err{color:var(--bad);font-size:12.5px;min-height:18px}

/* budget rows */
.plan{display:grid;gap:10px}
.brow2{display:grid;grid-template-columns:1fr auto;gap:8px 14px;align-items:center;padding:16px 0;border-top:1px solid var(--line)}
.brow2:first-child{border-top:0}
.brow2 .r1{display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;min-width:0}
.brow2 .nm{font-weight:600}
.brow2 .lim{width:min(168px,44vw)}
.brow2 .track{grid-column:1/-1;height:12px}
.brow2 .track .fill{background:var(--cc)}
.brow2 .r3{grid-column:1/-1;display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 16px;font-size:12.5px;color:var(--ink-2);font-variant-numeric:tabular-nums}

/* transactions */
.txgroup{margin-top:14px}
.txgroup h3{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:4px}
.txl{list-style:none;margin:0;padding:0}
.tx{display:grid;grid-template-columns:auto 1fr auto auto;gap:12px;align-items:center;padding:10px 0;border-top:1px solid var(--line)}
.txgroup .tx:first-child{border-top:0}
.tx .main{min-width:0;display:grid}
.tx .note{font-weight:600;overflow-wrap:anywhere}
.tx .cat{font-size:12px;color:var(--muted)}
.tx .amt{font-weight:700;font-variant-numeric:tabular-nums;text-align:right}
.tx .amt.in{color:var(--good)}
.tx .x{width:34px;height:34px;border:0;border-radius:50%;background:transparent;color:var(--muted);display:grid;place-items:center}
.tx .x:hover{background:var(--bad-soft);color:var(--bad)}

/* export */
.xcard{display:grid;gap:14px;align-content:start}
.xcard .badge{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;font-weight:800;font-size:12px;letter-spacing:.04em;color:#fff}
.xcard ul{margin:0;padding-left:18px;color:var(--ink-2)}
.xstatus{font-size:12.5px;color:var(--ink-2);min-height:18px}
.note-box{background:var(--surface-2);border-radius:14px;padding:12px 14px;font-size:13px;color:var(--ink-2)}

/* tooltip + toast */
.tip{position:fixed;z-index:60;pointer-events:none;background:var(--ink);color:var(--bg);padding:8px 11px;border-radius:10px;font-size:12px;display:grid;gap:1px;max-width:240px;box-shadow:var(--shadow)}
.tip[hidden]{display:none}
.tip b{font-weight:700}
.toast{position:fixed;z-index:70;left:50%;transform:translateX(-50%);bottom:calc(16px + env(safe-area-inset-bottom,0px));background:var(--hero-bg);color:var(--hero-ink);padding:10px 14px 10px 18px;border-radius:16px;display:flex;align-items:center;gap:14px;box-shadow:var(--shadow);max-width:calc(100% - 32px);font-weight:500}
.toast[hidden]{display:none}
.toast button{border:0;background:transparent;color:var(--hero-fill);font-weight:700;padding:4px 6px}

/* minimal transaction page */
.panel.narrow{width:100%;max-width:520px;margin-inline:auto}
.txf{display:grid;gap:12px}
.txf .btn{width:100%}
.txf input[type=text],.txf input[type=date],.txf select{min-height:42px;padding:8px 12px;border-radius:12px;font-size:13.5px}
.amt-big{position:relative}
.amt-big span{position:absolute;left:2px;top:50%;transform:translateY(-50%);font-family:var(--serif);font-size:28px;color:var(--muted);pointer-events:none}
.txf .amt-big input{border:0;border-bottom:1px solid var(--line);border-radius:0;background:transparent;font-family:var(--serif);font-size:42px;line-height:1.15;padding:4px 0 4px 46px;min-height:0;font-variant-numeric:tabular-nums}
.txf .amt-big input:focus-visible{outline:0;border-bottom-color:var(--accent)}
.txhead{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
.txhead h2{font-family:var(--serif);font-weight:400;font-size:24px}
.txhead span{color:var(--muted);font-size:12.5px}

/* savings */
.sv-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:20px}
.sv-grid>*{min-width:0}
.em{display:grid;gap:18px}
.em-top{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:flex-start;justify-content:space-between}
.pl{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:8px}
.pl b{font-family:var(--serif);font-weight:400;font-size:54px;line-height:1}
.em-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:14px}
.stat .k{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600}
.stat .v{font-weight:700;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.goal{display:grid;gap:12px;align-content:start}
.goal .gh{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.goal h3{font-family:var(--serif);font-weight:400;font-size:24px;line-height:1.15;overflow-wrap:anywhere}
.goal .big{font-weight:700;font-variant-numeric:tabular-nums}
.goal .meta{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:4px 14px;font-size:12.5px;color:var(--ink-2);font-variant-numeric:tabular-nums}
.dep{display:flex;gap:8px}
.dep .money{flex:1;min-width:0}
.dep .btn{min-height:46px;padding:8px 18px}
.linkbtn{border:0;background:transparent;color:var(--muted);font-size:12.5px;font-weight:600;padding:4px 8px;border-radius:8px;flex:none}
.linkbtn:hover{color:var(--bad);background:var(--bad-soft)}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chips label{position:relative}
.chips input{position:absolute;inset:0;opacity:0;margin:0;cursor:pointer;width:100%;height:100%}
.chips span{display:block;padding:7px 14px;border-radius:999px;border:1px solid var(--line);font-weight:600;font-size:13px;color:var(--ink-2);background:var(--surface)}
.chips input:checked+span{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.chips input:focus-visible+span{outline:2px solid var(--accent);outline-offset:2px}

/* recommendation */
#recBody{margin-top:14px;display:grid;gap:12px}
.rwrap{overflow-x:auto}
.rtable{width:100%;border-collapse:collapse;font-size:13px;font-variant-numeric:tabular-nums}
.rtable th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);font-weight:600;text-align:right;padding:6px 8px}
.rtable th:first-child,.rtable td:first-child{text-align:left}
.rtable td{padding:9px 8px;border-top:1px solid var(--line);text-align:right}
.rtable .nm{display:flex;align-items:center;gap:8px;font-weight:600}
.rtable td.dl{color:var(--ink-2)}
.rtable tfoot td{font-weight:700}

/* tahap 3 */
.linkbtn[data-editgoal]:hover{color:var(--accent);background:var(--accent-soft)}
#report{display:grid;gap:20px}
/* cadangan, berulang, peringatan */
.panel>#alertBox:empty{display:none}
.bkinfo{display:grid;gap:4px;font-size:13px;color:var(--ink-2);margin-bottom:14px}
.bkrow{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:12px}
.bkrow .btn{flex:1 1 170px}
#bkPreview{margin-bottom:12px;display:grid;gap:10px;font-size:13px}
.rmt{font-weight:700;font-variant-numeric:tabular-nums;text-align:right}
.rsub{font-size:12.5px;color:var(--muted)}
/* edit dan filter transaksi */
.acts{display:flex;gap:2px}
.tx .x.ed:hover{background:var(--accent-soft);color:var(--accent)}
.fmode{color:var(--accent);font-weight:600;font-size:13px}
/* akun dan arus kas */
.hero-note{font-size:12.5px;color:var(--hero-ink-2);margin-top:6px}
.flow{margin-top:18px;padding-top:16px;border-top:1px solid rgba(255,255,255,.16)}
.flow .eyebrow{display:block}
.flow strong{display:block;font-family:var(--serif);font-weight:400;font-size:clamp(28px,5vw,38px);line-height:1.1;font-variant-numeric:tabular-nums;margin-top:4px;overflow-wrap:anywhere}
.flow.neg strong{color:var(--hero-over)}
.flow small{display:block;font-size:12px;color:var(--hero-ink-2);margin-top:2px}
.arow{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px 16px;align-items:center;padding:14px 0;border-top:1px solid var(--line)}
.arow:first-child{border-top:0;padding-top:0}
.arow .nm{font-weight:600;overflow-wrap:anywhere}
.arow .abal{font-family:var(--serif);font-size:24px;font-variant-numeric:tabular-nums;text-align:right}
.arow .abal.neg{color:var(--bad)}
.acct-total{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding-top:14px;border-top:1px solid var(--line);font-weight:700}
.acct-total b{font-family:var(--serif);font-weight:400;font-size:28px}
@media (prefers-reduced-motion: reduce){.track .fill,.donut .seg{transition:none}}
</style>

<div class="app" id="app">
  <header class="top">
    <div class="brand">
      <h1>Pundi Harian</h1>
      <p>Catat uang masuk dan keluar, pantau anggaran tiap bulan.</p>
    </div>
    <div class="month" role="group" aria-label="Pilih bulan">
      <button type="button" id="prev" aria-label="Bulan sebelumnya"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></button>
      <span id="monthLabel" aria-live="polite"></span>
      <button type="button" id="next" aria-label="Bulan berikutnya"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>
  </header>

  <section class="hero" id="hero" aria-label="Ringkasan saldo"></section>

  <div class="banner" id="sampleBanner" hidden>
    <span>Angka di bawah ini adalah data contoh supaya kamu bisa melihat tampilannya. Hapus kapan saja untuk mulai dari nol.</span>
    <button type="button" id="clearSample">Hapus data contoh</button>
  </div>

  <nav class="tabs" role="tablist" aria-label="Tampilan">
    <button type="button" role="tab" id="t-ringkasan" data-tab="ringkasan" aria-selected="true" aria-controls="tab-ringkasan">Ringkasan</button>
    <button type="button" role="tab" id="t-laporan" data-tab="laporan" aria-selected="false" aria-controls="tab-laporan">Laporan</button>
    <button type="button" role="tab" id="t-akun" data-tab="akun" aria-selected="false" aria-controls="tab-akun">Akun</button>
    <button type="button" role="tab" id="t-anggaran" data-tab="anggaran" aria-selected="false" aria-controls="tab-anggaran">Anggaran</button>
    <button type="button" role="tab" id="t-transaksi" data-tab="transaksi" aria-selected="false" aria-controls="tab-transaksi">Transaksi</button>
    <button type="button" role="tab" id="t-tabungan" data-tab="tabungan" aria-selected="false" aria-controls="tab-tabungan">Tabungan</button>
    <button type="button" role="tab" id="t-ekspor" data-tab="ekspor" aria-selected="false" aria-controls="tab-ekspor">Ekspor</button>
  </nav>

  <main>
    <!-- RINGKASAN -->
    <section class="panel" id="tab-ringkasan" role="tabpanel" aria-labelledby="t-ringkasan">
      <div class="card empty" id="emptyNote" hidden>
        <h3 id="emptyTitle">Belum ada transaksi</h3>
        <p>Catat pengeluaran atau pemasukan pertamamu bulan ini, grafik akan terisi otomatis.</p>
        <button type="button" class="btn" id="goTx">Catat transaksi</button>
      </div>
      <div id="alertBox" style="display:grid;gap:10px"></div>
      <div class="card"><div class="insights" id="insights"></div></div>
      <div class="grid2">
        <div class="card">
          <div class="ch"><div><h2>Ke mana uangnya pergi</h2><p class="sub">Pengeluaran per kategori</p></div></div>
          <div class="donut-wrap" id="donut"></div>
        </div>
        <div class="card">
          <div class="ch"><div><h2>Anggaran vs terpakai</h2><p class="sub">Bar penuh berarti anggaran kategori habis</p></div></div>
          <div class="blist" id="bars"></div>
        </div>
      </div>
      <div class="card">
        <div class="ch">
          <div><h2>Laju pengeluaran</h2><p class="sub">Total terkumpul per tanggal dibanding laju anggaran</p></div>
          <div class="legend-row"><span><i class="sw-line"></i>Pengeluaran terkumpul</span><span><i class="sw-dash"></i>Laju anggaran</span></div>
        </div>
        <div id="trend"></div>
      </div>
    </section>

    <!-- LAPORAN -->
    <section class="panel" id="tab-laporan" role="tabpanel" aria-labelledby="t-laporan" hidden><div id="report"></div></section>

    <!-- AKUN -->
    <section class="panel" id="tab-akun" role="tabpanel" aria-labelledby="t-akun" hidden>
      <div class="card">
        <div class="ch"><div><h2>Akun</h2><p class="sub">Dompet, rekening bank, e-wallet. Total saldo adalah jumlah saldo semua akun sampai hari ini.</p></div></div>
        <div id="acctList"></div>
        <div class="acct-total" id="acctTotal"></div>
      </div>
      <form class="card form" id="acctForm" novalidate>
        <div><h2>Tambah akun</h2><p class="sub">Isi saldo awal sebesar uang yang ada di akun itu sekarang.</p></div>
        <div class="row2">
          <div class="field"><label for="a-name">Nama akun</label><input type="text" id="a-name" maxlength="30" autocomplete="off" placeholder="Contoh: E-wallet"></div>
          <div class="field"><label for="a-start">Saldo awal</label><div class="money"><span>Rp</span><input type="text" id="a-start" inputmode="numeric" autocomplete="off" placeholder="0"></div></div>
        </div>
        <div class="err" id="a-err" role="alert"></div>
        <button type="submit" class="btn">Tambah akun</button>
      </form>
      <form class="card form" id="trfForm" novalidate>
        <div><h2>Transfer antar-akun</h2><p class="sub">Memindahkan uang tidak mengubah total saldo dan tidak dihitung sebagai pemasukan atau pengeluaran.</p></div>
        <div class="row2">
          <div class="field"><label for="t-from">Dari</label><select id="t-from"></select></div>
          <div class="field"><label for="t-to">Ke</label><select id="t-to"></select></div>
        </div>
        <div class="field"><label for="t-amt">Jumlah</label><div class="money"><span>Rp</span><input type="text" id="t-amt" inputmode="numeric" autocomplete="off" placeholder="0"></div></div>
        <div class="row2">
          <div class="field"><label for="t-date">Tanggal</label><input type="date" id="t-date"></div>
          <div class="field"><label for="t-note">Catatan (opsional)</label><input type="text" id="t-note" maxlength="80" autocomplete="off" placeholder="Contoh: Tarik tunai"></div>
        </div>
        <div class="err" id="t-err" role="alert"></div>
        <button type="submit" class="btn">Transfer</button>
      </form>
      <div class="txhead"><h2>Riwayat transfer</h2><span id="trfCount"></span></div>
      <div id="trfList"></div>
    </section>

    <!-- ANGGARAN -->
    <section class="panel" id="tab-anggaran" role="tabpanel" aria-labelledby="t-anggaran" hidden>
      <div class="card">
        <div class="ch"><div><h2>Anggaran bulanan</h2><p class="sub">Atur batas tiap kategori. Perubahan tersimpan otomatis untuk bulan ini dan disalin ke bulan baru.</p></div></div>
        <div class="plan">
          <div class="field">
            <label for="plan">Target pemasukan bulan ini</label>
            <div class="money"><span>Rp</span><input type="text" id="plan" inputmode="numeric" autocomplete="off" placeholder="0"></div>
          </div>
          <div id="alloc" class="sub"></div>
          <div class="track" aria-hidden="true"><div class="fill" id="allocFill" style="width:0"></div></div>
        </div>
      </div>
      <div class="card">
        <div class="ch"><div><h2>Rekomendasi budget otomatis</h2><p class="sub">Saran dibuat dari pemasukan dan pola pengeluaranmu. Tidak ada yang berubah sampai kamu menerapkannya.</p></div></div>
        <div class="chips" role="radiogroup" aria-label="Pilih strategi">
          <label><input type="radio" name="rec" value="seimbang" checked><span>50/30/20</span></label>
          <label><input type="radio" name="rec" value="kebiasaan"><span>Sesuai kebiasaanku</span></label>
          <label><input type="radio" name="rec" value="hemat"><span>Hemat</span></label>
        </div>
        <div id="recBody"></div>
      </div>
      <div class="card">
        <div id="budgetRows"></div>
      </div>
      <form class="card form" id="catForm" novalidate>
        <div><h2>Kategori kustom</h2><p class="sub">Tambah kategori pengeluaran sendiri (maksimal 8). Atur anggarannya di daftar di atas.</p></div>
        <div id="catList"></div>
        <div class="field"><label for="c-name">Nama kategori</label><input type="text" id="c-name" maxlength="24" autocomplete="off" placeholder="Contoh: Hewan peliharaan"></div>
        <div class="err" id="c-err" role="alert"></div>
        <button type="submit" class="btn">Tambah kategori</button>
      </form>
    </section>

    <!-- TRANSAKSI -->
    <section class="panel narrow" id="tab-transaksi" role="tabpanel" aria-labelledby="t-transaksi" hidden>
      <form class="card txf" id="txForm" novalidate>
        <p class="fmode" id="f-mode" hidden>Mengubah transaksi yang sudah ada</p>
        <div class="segmented" role="radiogroup" aria-label="Jenis transaksi">
          <label><input type="radio" name="ftype" value="out" id="ft-out" checked><span>Pengeluaran</span></label>
          <label><input type="radio" name="ftype" value="in" id="ft-in"><span>Pemasukan</span></label>
        </div>
        <div class="amt-big"><span aria-hidden="true">Rp</span><input type="text" id="f-amt" inputmode="numeric" autocomplete="off" placeholder="0" aria-label="Jumlah"></div>
        <div class="row2">
          <div class="field"><label for="f-cat" id="f-cat-l">Kategori</label><select id="f-cat"></select></div>
          <div class="field"><label for="f-date">Tanggal</label><input type="date" id="f-date"></div>
        </div>
        <div class="field"><label for="f-acct">Akun</label><select id="f-acct"></select></div>
        <div class="field" id="f-goal-w" hidden><label for="f-goal">Untuk target tabungan</label><select id="f-goal"></select></div>
        <input type="text" id="f-note" maxlength="80" autocomplete="off" placeholder="Catatan (opsional)" aria-label="Catatan">
        <div class="err" id="f-err" role="alert"></div>
        <button type="submit" class="btn" id="f-submit">Tambah</button>
        <button type="button" class="btn ghost" id="f-cancel" hidden>Batal mengubah</button>
      </form>
      <form class="card form" id="recForm" novalidate>
        <div><h2>Transaksi berulang</h2><p class="sub">Dicatat otomatis tiap bulan pada tanggal yang sama, mulai dari tanggal yang dipilih.</p></div>
        <div class="row2">
          <div class="field"><label for="r-type">Jenis</label><select id="r-type"><option value="out">Pengeluaran</option><option value="in">Pemasukan</option></select></div>
          <div class="field"><label for="r-cat" id="r-cat-l">Kategori</label><select id="r-cat"></select></div>
        </div>
        <div class="row2">
          <div class="field"><label for="r-acct">Akun</label><select id="r-acct"></select></div>
          <div class="field"><label for="r-date">Mulai tanggal</label><input type="date" id="r-date"></div>
        </div>
        <div class="field"><label for="r-amt">Jumlah</label><div class="money"><span>Rp</span><input type="text" id="r-amt" inputmode="numeric" autocomplete="off" placeholder="0"></div></div>
        <div class="field"><label for="r-note">Catatan</label><input type="text" id="r-note" maxlength="80" autocomplete="off" placeholder="Contoh: Sewa kos"></div>
        <div class="err" id="r-err" role="alert"></div>
        <button type="submit" class="btn">Jadwalkan</button>
        <div id="recList"></div>
      </form>
      <div class="card txf" id="txFilter">
        <input type="text" id="fl-q" autocomplete="off" placeholder="Cari catatan, kategori, akun, atau jumlah" aria-label="Cari transaksi">
        <div class="row2">
          <div class="field"><label for="fl-type">Jenis</label><select id="fl-type"><option value="">Semua jenis</option><option value="out">Pengeluaran</option><option value="in">Pemasukan</option></select></div>
          <div class="field"><label for="fl-cat">Kategori</label><select id="fl-cat"></select></div>
        </div>
        <div class="row2">
          <div class="field"><label for="fl-acct">Akun</label><select id="fl-acct"></select></div>
          <div class="field"><label for="fl-scope">Rentang</label><select id="fl-scope"><option value="month">Bulan yang dibuka</option><option value="all">Semua bulan</option></select></div>
        </div>
        <button type="button" class="btn ghost" id="fl-reset" hidden>Atur ulang pencarian dan filter</button>
      </div>
      <div class="txhead"><h2>Riwayat</h2><span id="txCount"></span></div>
      <div id="txList"></div>
    </section>

    <!-- TABUNGAN -->
    <section class="panel" id="tab-tabungan" role="tabpanel" aria-labelledby="t-tabungan" hidden>
      <div class="card"><div class="insights" id="svSummary"></div></div>
      <div class="card">
        <div class="field"><label for="sv-acct">Setoran diambil dari akun</label><select id="sv-acct"></select></div>
        <p class="sub" style="margin-top:8px">Setoran dicatat sebagai pengeluaran kategori Tabungan dan mengurangi saldo akun ini, sama seperti pengeluaran lain. Tabungan tetap dihitung dalam anggaran bulanan.</p>
      </div>

      <div class="card em">
        <div class="em-top">
          <div><h2>Dana darurat</h2><p class="sub" id="em-base"></p></div>
          <div class="chips" role="radiogroup" aria-label="Target dana darurat dalam bulan">
            <label><input type="radio" name="emm" value="3"><span>3 bulan</span></label>
            <label><input type="radio" name="emm" value="6" checked><span>6 bulan</span></label>
            <label><input type="radio" name="emm" value="9"><span>9 bulan</span></label>
            <label><input type="radio" name="emm" value="12"><span>12 bulan</span></label>
          </div>
        </div>
        <div>
          <div class="pl"><b id="em-pct">0%</b><span class="sub" id="em-line"></span></div>
          <div class="track" aria-hidden="true"><div class="fill" id="em-fill" style="width:0;background:var(--c3)"></div></div>
        </div>
        <div class="em-stats" id="em-stats"></div>
        <div class="row2">
          <div class="field"><label for="em-start">Saldo awal dana darurat</label><div class="money"><span>Rp</span><input type="text" id="em-start" inputmode="numeric" autocomplete="off" placeholder="0"></div></div>
          <div class="field"><label for="em-monthly">Rencana setoran per bulan</label><div class="money"><span>Rp</span><input type="text" id="em-monthly" inputmode="numeric" autocomplete="off" placeholder="0"></div></div>
        </div>
        <form class="dep" id="emDep" novalidate>
          <div class="money"><span>Rp</span><input type="text" id="em-dep" inputmode="numeric" autocomplete="off" placeholder="Jumlah setoran" aria-label="Setoran dana darurat"></div>
          <button type="submit" class="btn">Setor</button>
        </form>
        <p class="sub">Setoran otomatis tercatat sebagai pengeluaran kategori Tabungan di bulan yang sedang dibuka.</p>
      </div>

      <div class="txhead"><h2>Target tabungan</h2><span>Impian dengan jumlah dan tenggat</span></div>
      <div class="sv-grid" id="goals"></div>

      <form class="card form" id="goalForm" novalidate>
        <div><h2>Tambah target</h2><p class="sub">Misalnya liburan, gawai baru, atau uang muka rumah.</p></div>
        <div class="field"><label for="g-name">Nama target</label><input type="text" id="g-name" maxlength="40" autocomplete="off" placeholder="Contoh: Liburan ke Lombok"></div>
        <div class="row2">
          <div class="field"><label for="g-target">Jumlah target</label><div class="money"><span>Rp</span><input type="text" id="g-target" inputmode="numeric" autocomplete="off" placeholder="0"></div></div>
          <div class="field"><label for="g-start">Sudah terkumpul</label><div class="money"><span>Rp</span><input type="text" id="g-start" inputmode="numeric" autocomplete="off" placeholder="0"></div></div>
        </div>
        <div class="field"><label for="g-date">Tenggat (opsional)</label><input type="date" id="g-date"></div>
        <div class="err" id="g-err" role="alert"></div>
        <button type="submit" class="btn" id="g-submit">Tambah target</button>
        <button type="button" class="btn ghost" id="g-cancel" hidden>Batal mengubah</button>
      </form>
    </section>

    <!-- EKSPOR -->
    <section class="panel" id="tab-ekspor" role="tabpanel" aria-labelledby="t-ekspor" hidden>
      <div class="note-box" id="dlNote"></div>
      <div class="card">
        <div class="ch"><div><h2>Uji ekspor</h2><p class="sub">Membuat Excel dan PDF di memori lalu mencocokkan isinya dengan data. Tidak ada file yang disimpan.</p></div></div>
        <button type="button" class="btn ghost" id="expTest">Jalankan uji ekspor</button>
        <div class="xstatus" id="xs-test" role="status" style="white-space:pre-line"></div>
      </div>
      <div class="grid2">
        <div class="card xcard">
          <div class="badge" style="background:#1d6f42">XLSX</div>
          <div><h2>Excel</h2><p class="sub">Workbook dengan rumus yang hidup, bisa kamu ubah lagi di Excel atau Google Sheets.</p></div>
          <ul><li>Ringkasan bulan terpilih</li><li>Anggaran dan terpakai per kategori</li><li>Transaksi bulan ini dan semua bulan</li></ul>
          <button type="button" class="btn" id="expXlsx">Unduh Excel</button>
          <div class="xstatus" id="xs-xlsx" role="status"></div>
        </div>
        <div class="card xcard">
          <div class="badge" style="background:#b24a73">PDF</div>
          <div><h2>Laporan PDF</h2><p class="sub">Satu laporan rapi untuk bulan terpilih, siap dibagikan atau diarsipkan.</p></div>
          <ul><li>Saldo, pemasukan, pengeluaran</li><li>Grafik anggaran vs terpakai</li><li>Tabel semua transaksi</li></ul>
          <button type="button" class="btn" id="expPdf">Unduh PDF</button>
          <div class="xstatus" id="xs-pdf" role="status"></div>
        </div>
      </div>
      <div class="card">
        <div class="ch"><div><h2>Data dan cadangan</h2><p class="sub">Catatanmu tersimpan di peramban ini saja. Unduh cadangan secara berkala dan simpan filenya di tempat lain.</p></div></div>
        <div class="bkinfo" id="bkInfo"></div>
        <div class="bkrow"><button type="button" class="btn" id="bkExport">Unduh cadangan (JSON)</button><button type="button" class="btn ghost" id="bkPick">Pulihkan dari file</button><button type="button" class="btn ghost" id="bkCheck">Periksa penyimpanan</button></div>
        <input type="file" id="bkFile" accept=".json,application/json" hidden>
        <div class="note-box" id="bkPreview" hidden></div>
        <div class="xstatus" id="bkStatus" role="status" style="white-space:pre-line"></div>
        <button type="button" class="btn danger" id="wipe">Hapus semua data</button>
      </div>
    </section>
  </main>
</div>

<div class="tip" id="tip" hidden></div>
<div class="toast" id="toast" hidden role="status"><span id="toastMsg"></span><button type="button" id="toastAct" hidden></button></div>

<script>
(function(){
'use strict';

/* ---------- constants ---------- */
var BULAN=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
var BLN=['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
var HARI=['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
var CATS=[
  {id:'makan',name:'Makan & Minum',def:1200000},
  {id:'transport',name:'Transportasi',def:400000},
  {id:'tinggal',name:'Tempat Tinggal',def:1300000},
  {id:'tagihan',name:'Tagihan & Pulsa',def:600000},
  {id:'hiburan',name:'Hiburan',def:300000},
  {id:'tabungan',name:'Tabungan',def:1000000},
  {id:'sehat',name:'Kesehatan',def:200000},
  {id:'belanja',name:'Belanja',def:700000}
];
CATS.forEach(function(c,i){c.i=i+1;});
var BASE_CATS=CATS.length;
var CAT_HEX=['#2a78d6','#eb6834','#1baf7a','#eda100','#e87ba4','#008300','#6250d6','#e34948'];
var SRC=['Gaji','Freelance','Bonus','Lainnya'];
var KEY='pundi-harian-v1';
var NEEDS={tinggal:0.34,makan:0.28,transport:0.14,tagihan:0.16,sehat:0.08};
var WANTS={hiburan:0.4,belanja:0.6};
var STRAT={
  seimbang:{n:0.5,w:0.3,s:0.2,desc:'50% kebutuhan, 30% keinginan, 20% tabungan.'},
  kebiasaan:{s:0.2,desc:'Mengikuti rata-rata pengeluaranmu 3 bulan terakhir, tabungan minimal 20% dari pemasukan.'},
  hemat:{n:0.5,w:0.15,s:0.35,desc:'Kebutuhan tetap 50%, keinginan dipangkas, tabungan 35%.'}
};
var recKey='seimbang';

/* ---------- helpers ---------- */
function $(s,r){return (r||document).querySelector(s);}
function $$(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s));}
function esc(s){return String(s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
var nf=new Intl.NumberFormat('id-ID');
function rp(n){return (n<0?'-':'')+'Rp '+nf.format(Math.abs(Math.round(n)));}
function short(n){
  var a=Math.abs(n),s;
  if(a>=1e6){s=(a/1e6).toFixed(a>=1e7?0:1).replace('.',',').replace(/,0$/,'')+' jt';}
  else if(a>=1e3){s=Math.round(a/1e3)+' rb';}
  else{s=String(Math.round(a));}
  return (n<0?'-':'')+'Rp '+s;
}
function pad(n){return String(n).padStart(2,'0');}
function ymOf(d){return d.getFullYear()+'-'+pad(d.getMonth()+1);}
function todayStr(){var d=new Date();return ymOf(d)+'-'+pad(d.getDate());}
function daysIn(ym){var p=ym.split('-').map(Number);return new Date(p[0],p[1],0).getDate();}
function monthLabel(ym){var p=ym.split('-').map(Number);return BULAN[p[1]-1]+' '+p[0];}
function shiftMonth(ym,k){var p=ym.split('-').map(Number);return ymOf(new Date(p[0],p[1]-1+k,1));}
function fmtDay(ds){var p=ds.split('-').map(Number);var d=new Date(p[0],p[1]-1,p[2]);return HARI[d.getDay()]+', '+p[2]+' '+BLN[p[1]-1];}
function fmtFull(ds){var p=ds.split('-').map(Number);return p[2]+' '+BLN[p[1]-1]+' '+p[0];}
function parseRp(s){var n=parseInt(String(s).replace(/\D/g,''),10);return isNaN(n)?0:Math.min(n,9e12);}
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,7);}
function catById(id){for(var i=0;i<CATS.length;i++){if(CATS[i].id===id)return CATS[i];}return null;}
function elapsed(ym,days){var t=todayStr(),cm=t.slice(0,7);if(ym<cm)return days;if(ym>cm)return 0;return +t.slice(8,10);}
function niceStep(raw){var p=Math.pow(10,Math.floor(Math.log10(raw)));var f=raw/p;var n=f<=1?1:f<=2?2:f<=2.5?2.5:f<=5?5:10;return n*p;}
function statusOf(spent,limit){
  if(!limit){return spent>0?{k:'bad',t:'▲ Tanpa anggaran'}:{k:'mute',t:'– Belum diatur'};}
  var p=spent/limit;
  if(p>1)return {k:'bad',t:'▲ Melebihi'};
  if(p>=0.8)return {k:'warn',t:'! Hampir habis'};
  return {k:'good',t:'✓ Aman'};
}
function fmtInput(el){
  var raw=el.value;var pos=el.selectionStart==null?raw.length:el.selectionStart;
  var fromEnd=raw.length-pos;var digits=raw.replace(/\D/g,'');
  var n=parseRp(raw);var out=digits===''?'':nf.format(n);
  el.value=out;var np=Math.max(0,out.length-fromEnd);
  try{el.setSelectionRange(np,np);}catch(e){}
  return n;
}

